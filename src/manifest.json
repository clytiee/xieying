{
  "manifest_version": 3,
  "name": "Element Screenshot 元素截图",
  "version": "1.0.4",
  "description": "One‑click screenshot for webpage element. Auto‑stitch long scroll blocks, auto‑hide sticky/fixed headers, copy or download directly.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Element Screenshot",
	"default_icon": {
		"48": "icon48.png"
	}
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png"
  }
}